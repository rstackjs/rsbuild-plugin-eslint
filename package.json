{
  "name": "@rsbuild/plugin-eslint",
  "version": "2.0.2",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-eslint#readme",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-eslint",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-eslint/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks",
    "test": "playwright test",
    "bump": "pnpx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "dependencies": {
    "eslint-rspack-plugin": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "^2.1.2",
    "@rslib/core": "^0.23.1",
    "@rslint/core": "^0.6.4",
    "@types/node": "^24.13.2",
    "eslint": "^10.6.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.9.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
