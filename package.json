{
  "name": "@rsbuild/plugin-eslint",
  "version": "2.0.2",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-eslint#readme",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-eslint",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-eslint/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "rs test"
  },
  "dependencies": {
    "eslint-rspack-plugin": "5.0.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.2",
    "@rstest/playwright": "^0.11.11",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "rstack": "^0.7.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
