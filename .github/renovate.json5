{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "schedule:monthly",
    "group:allNonMajor",
    ":automergeStableNonMajor"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    { "depTypeList": ["peerDependencies"], "enabled": false }
  ]
}